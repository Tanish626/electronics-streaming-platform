# Host port for connecting to Kafka from your laptop (the simulator uses this)
KAFKA_EXTERNAL_PORT=9094
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# Kafka UI (8080 is kept free for Airflow later)
KAFKA_UI_PORT=8081

# --- Event simulator ---
# Simulation steps per second (~1 event per step; checkouts emit several)
SIM_STEPS_PER_SECOND=20
# Concurrent shopper sessions
SIM_ACTIVE_SESSIONS=50
# Distinct users to draw from
SIM_USER_POOL=2000
# Fraction of events with event_time shifted 1-10 minutes into the past
SIM_LATE_EVENT_RATE=0.02
# Fraction of events sent twice (same event_id)
SIM_DUPLICATE_RATE=0.01
# Stop after N events (0 = run until Ctrl+C)
SIM_MAX_EVENTS=0
# Optional: set an integer for reproducible runs
SIM_SEED=

# --- MinIO (S3-compatible object storage) ---
# --- S3-compatible object storage (SeaweedFS) ---
S3_ACCESS_KEY=lakeadmin
S3_SECRET_KEY=lakesecret123
S3_API_PORT=8333
S3_ADMIN_UI_PORT=23646
LAKE_BUCKET=lakehouse